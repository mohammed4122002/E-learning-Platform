# Public (safe to expose to the browser). Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Absolute origin used in auth e-mails (password reset, confirmation) and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix with NEXT_PUBLIC_. Only needed by the payment webhook (settle_payment).
# SUPABASE_SERVICE_ROLE_KEY=
# PAYMENT_WEBHOOK_SECRET=
